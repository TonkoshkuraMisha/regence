# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/

# IDE settings
.idea/
.vscode/

# Environment variables and secrets
.env
.env.*
# Templates without secrets are kept in the repository
!.env.example

# Logs and databases
*.log
*.sqlite3

# OS generated files
.DS_Store
Thumbs.db

# Seed data
src/db/data/pgns/
*.pgn

# Engine binaries
bin/
*.exe

node_modules/
# Project snapshots
project_snapshot*.txt
data/pgns/

# Caches and reports of code-quality tools
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Database backups (docker-compose.prod.yml, backup service)
backups/

# MCP config that PyCharm generates on every host (the port differs)
.mcp.json

# Bot calibration logs - data for recomputing ratings (scripts/calibrate_bots.py --from-log/--reuse-log)
!scripts/calibration_runs/*.log

# Project snapshot for the AI assistant (make_snapshot.py) - generated locally, not stored in git.
# Status summary - python make_snapshot.py --status (or _project_snapshot/STATUS.md after generation).
_project_snapshot/
.venv/
# Calibration games - for style metrics (scripts/style_metrics.py), small.
!scripts/calibration_runs/*.pgn

# Claude Code: personal settings on this host
.claude/settings.local.json
# Development logs (start_dev.ps1 writes json logs of api and worker here)
logs/

# Origin certificate and Cloudflare IP list for nginx - on the server only (DEPLOY.md, section 4).
/deploy/

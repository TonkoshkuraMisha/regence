# --- FILE: frontend/.env.example ---
# Backend addresses for development (npm run dev). If unset, http://127.0.0.1:8000.
# In the production build (frontend/Dockerfile) they are not set: the API and WebSocket are taken from the same
# domain as the page.
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000
# Sentry project DSN for the page (regence-web, src/services/sentry.ts). Empty means Sentry is off on the page.
VITE_SENTRY_DSN=
# Source map upload token at build time (not in development): SENTRY_AUTH_TOKEN=... - see DEPLOY.md, section 6.

# --- FILE: .env.example ---
# Copy to .env and fill in. For development the values below match docker-compose.yml.
# For production (docker-compose.prod.yml) you must change the DB password and SECRET_KEY.

# development | production. In production the app refuses to start with a weak SECRET_KEY
# and does not publish /docs.
ENVIRONMENT=development

# PostgreSQL. In production POSTGRES_SERVER/PORT are set by docker-compose.prod.yml (db:5432).
POSTGRES_USER=regence_user
POSTGRES_PASSWORD=regence_password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=regence_db

# Redis. In production it is set by docker-compose.prod.yml (redis:6379).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Token signing. For production, a random string of at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key

# Allowed CORS origins, comma-separated. In production the frontend and the API share one domain,
# so this can be left empty.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Observability. Sentry is off while SENTRY_DSN is empty. Fraction of requests with performance
# tracing (0.0-1.0): 0 means errors only.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Port of the Celery worker /metrics endpoint (engine time in background analysis and simulations); 0 disables it. In production
# docker-compose.prod.yml sets it for the worker and worker-simulation services, so it is not needed here.
WORKER_METRICS_PORT=0

# --- docker-compose.prod.yml only ---
# External nginx port, number of uvicorn and Celery processes.
HTTP_PORT=80
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
# CPU limit of the analysis worker (cores): game analysis must not take CPU away from the API.
WORKER_CPUS=1.0
# Worker for bot games in tournaments (separate simulation queue): how many games run at once and the CPU limit.
SIMULATION_CONCURRENCY=1
SIMULATION_CPUS=0.5

# Mail (e-mail confirmation and password reset). An empty SMTP_HOST means no mail is sent; messages are written to the log
# instead (development). Any transactional mail provider (Brevo, Amazon SES, Postmark...) - only these variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=regence <noreply@example.com>
# Site address used for links in e-mails.
# On the server - the site address: https://regence.club
PUBLIC_BASE_URL=http://localhost:5173

# Beta programme. REGISTRATION_INVITE_ONLY=true - registration only by invite code (codes are created by a moderator on
# the /moderation page); by default registration is open. COMMUNITY_URL - link to the community channel, for example
# https://t.me/<channel address>: empty - no link is shown on the site.
REGISTRATION_INVITE_ONLY=false
# Consent to the community rules and privacy policy at registration (task 23.1): without the checkbox - rejected.
REQUIRE_TERMS_CONSENT=true
# Account deletion (task 23.1): days of the grace period - the account is closed at once and anonymised after them;
# logging in with the password during this time restores it.
ACCOUNT_DELETION_GRACE_DAYS=10
# Logs (src/core/logging_setup.py): LOG_FORMAT = json | text | auto (auto: json in production, text in development);
# LOG_LEVEL - DEBUG/INFO/WARNING/ERROR; LOG_FILE - optional rotating json file (LOG_FILE_MAX_MB, LOG_FILE_BACKUPS).
# RATE_LIMIT_CLIENT_ERRORS - how many page error reports to accept per address per window (the rest are silently dropped).
LOG_FORMAT=auto
LOG_LEVEL=INFO
LOG_FILE=
COMMUNITY_URL=https://t.me/regence_club

# Arenas and conferences (DEPLOY.md, section 8d). ARENA_CONFERENCES - conferences whose schedule arenas are created from:
# while there are few players the list can be shortened (for example, central). COUNTRY_HEADER - proxy header with the
# visitor's country (for example, CF-IPCountry): the country from it is only suggested to the player and is not stored;
# empty - no address-based hints.
ARENA_CONFERENCES=central,western,northern,southern,eastern
COUNTRY_HEADER=

# Database backups (backup service): host folder, snapshot interval and retention period.
# Copy the contents of BACKUP_DIR off the server - a backup on the same disk will not survive losing it.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Restore check of the latest snapshot once every N days (0 - off) and a webhook for alerts about a failed
# snapshot or check (POST with text; empty - only an ERROR line in the backup service log).
BACKUP_VERIFY_EVERY_DAYS=7
BACKUP_ALERT_WEBHOOK_URL=
# Off-server copy of snapshots (offsite profile, DEPLOY section 5): the rclone remote `offsite`
# and the path in it. Example for S3-compatible storage - uncomment and fill in.
# BACKUP_OFFSITE_PATH=offsite:regence-backups
# BACKUP_OFFSITE_INTERVAL_HOURS=24
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

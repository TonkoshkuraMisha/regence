   "en": {
    "title": "Vienna 1898",
    "place": "Vienna, 1 June – 25 July 1898",
    "story": "The Kaiser Jubilee tournament: nineteen masters, two games against each, thirty-six games apiece. It is one of the longest tournaments ever played. Tarrasch and Pillsbury tied for first, and Tarrasch won the play-off match 2½–1½.",
    "real": "Tarrasch and Pillsbury tied with 27½ out of 36; Tarrasch won the play-off. Janowski was third with 25½."
   },
   "uk": {
    "title": "Відень 1898",
    "place": "Відень, 1 червня – 25 липня 1898",
    "story": "Ювілейний турнір на честь імператора: дев’ятнадцять майстрів, по дві партії з кожним — тридцять шість партій у кожного. Один із найдовших турнірів в історії. Тарраш і Пільсбері поділили перше місце, додатковий матч Тарраш виграв 2½:1½.",
    "real": "Тарраш і Пільсбері набрали по 27½ із 36; додатковий матч виграв Тарраш. Третім був Яновський (25½)."
   }
